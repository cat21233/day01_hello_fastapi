# ============================================================
# 复制为 .env 后填入真实值：
#     cp .env.example .env        # PowerShell: copy .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交；本文件是提交用的模板。
# ⚠️ 任何真实密钥都不要写进这里。
# ============================================================

# --- 应用配置 ---
APP_NAME=我的FastAPI学习项目
PORT=8000
DEBUG=true

# --- LLM 厂商选择：agnes / deepseek / zhipu ---
LLM_PROVIDER=deepseek

# --- Agnes 网关 ---
AGNES_API_KEY=your-agnes-api-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# --- DeepSeek 官方 ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 智谱 GLM ---
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
# --- 数据库：业务数据（users 表等）---
# 不写 DATABASE_URL = 走默认的 SQLite 文件 ./app.db（零配置，测试/离线开发够用）
# 接本机 MySQL（phpstudy）时，取消下面这行的注释并按实际改：
# DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/day01?charset=utf8mb4
#   ⚠️ charset=utf8mb4 必须带：MySQL 的 "utf8" 只有 3 字节，存 emoji 直接报错
#   ⚠️ 密码含 @ : / # 时必须 URL 编码（@ 写成 %40），否则会被当成分隔符
#   ⚠️ 库要先建好：CREATE DATABASE day01 CHARACTER SET utf8mb4;
# 把每条 SQL 打到控制台（排查「为什么查出来是空的」）：
DATABASE_ECHO=false
# 启动时自动插入演示账号 zihao/test（生产环境务必 false）
DB_AUTO_SEED=true

# --- 安全：JWT 签名密钥（秘密！必须自己生成，别照抄本文件）---
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 故意留空：本文件被 cp 成 .env 后，validate_settings() 会立刻抛 ConfigError，
# 提醒你去填真值 —— 绝不让你用一个公开在仓库里的示例密钥静默跑起来。
JWT_SECRET_KEY=
